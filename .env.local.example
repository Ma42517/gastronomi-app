# ============================================================
# gastronomi-app — Variables de entorno
# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` al repositorio.
# ============================================================

# --- Supabase ---
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo para el servidor (rutas API / server actions). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Pasarela de pagos (elegir una para el MVP) ---
# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Stripe (alternativa)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
