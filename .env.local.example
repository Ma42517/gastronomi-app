# ============================================================
# gastronomi-app — Variables de entorno
# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` al repositorio.
# ============================================================

# --- Supabase ---
# Panel de Supabase > Project Settings > API Keys
#
# Supabase mantiene DOS sistemas de llaves en paralelo. La app soporta ambos:
#
#   SISTEMA NUEVO (recomendado; el legacy se retira a finales de 2026)
#     pestaña "Publishable and secret API keys"
#     - Publishable key -> sb_publishable_...  (va en NEXT_PUBLIC_..._ANON_KEY)
#     - Secret key      -> sb_secret_...      (va en ..._SERVICE_ROLE_KEY)
#
#   SISTEMA LEGACY
#     - anon public  -> eyJ...  (rol anon)
#     - service_role -> eyJ...  (rol service_role)
#
# Los nombres de las variables NO cambian: siguen siendo los de abajo, aunque
# uses las llaves nuevas.
#
# ---- PÚBLICAS: viajan en el bundle del navegador ----
# Con ellas la app solo puede LEER el menú (RLS no permite escritura pública).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-publishable-key
#
# ---- PRIVADA: nunca sale del servidor ----
# OBLIGATORIA para que el Panel Administrador pueda GUARDAR. Las rutas
# /api/admin/* la usan para saltar RLS de forma controlada.
# NUNCA le pongas el prefijo NEXT_PUBLIC_: quien tenga esta llave puede
# reescribir la base de datos completa. El diagnóstico
# (/api/admin/diagnostico) avisa si se confunden de sitio.
SUPABASE_SERVICE_ROLE_KEY=tu-secret-key
#
# Slug del restaurante que sirve esta instancia (columna `slug` de la tabla
# `restaurantes`). Si no se define, se usa "el-primo".
NEXT_PUBLIC_RESTAURANTE_SLUG=el-primo

# --- Pasarela de pagos (elegir una para el MVP) ---
# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Stripe (alternativa)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- IA: Ñom AI (Vercel AI SDK + Google Gemini) ---
# Llave de Google AI Studio (https://aistudio.google.com/apikey).
# Necesaria para que el chat de Ñom AI responda.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
